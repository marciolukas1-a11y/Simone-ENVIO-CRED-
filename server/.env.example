# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" nunca entra no Git (ver .gitignore).

# --- Groq (IA de atendimento) ---
GROQ_API_KEY=
# Modelo recomendado: suporta função/ferramenta e tem bom português.
# Ver server/README.md para a justificativa da escolha.
GROQ_MODEL=openai/gpt-oss-120b

# --- SearchApi.io (IA de pesquisa, só usada quando o Groq não souber responder) ---
RESEARCH_PROVIDER=searchapi
RESEARCH_API_KEY=

# --- WhatsApp (Baileys -- aparelho conectado, pareamento por código) ---
# Pasta onde a sessão do WhatsApp fica salva em disco. Não precisa existir
# antes -- o servidor cria sozinho.
WHATSAPP_SESSION_DIR=./dados/sessao-whatsapp
# Número que vai ser pareado (com DDI+DDD, só números, ex: 5583999628152)
WHATSAPP_PHONE_NUMBER=5583999628152

# --- API REST para o app ENVIO CRED ---
# Gere um valor aleatório comprido (ex: openssl rand -hex 32) e nunca
# compartilhe -- é a senha que o app usa pra falar com este servidor.
APP_API_TOKEN=

# --- Banco de dados ---
DATABASE_PATH=./dados/enviocred.sqlite

# --- Servidor HTTP ---
PORT=3000
HOST=0.0.0.0

# --- Horário de atendimento automático (24h, fuso do aparelho) ---
HORARIO_INICIO=08:00
HORARIO_FIM=20:00
