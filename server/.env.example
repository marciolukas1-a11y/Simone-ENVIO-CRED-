# Este arquivo é OPCIONAL -- o servidor roda sem ele, com valores padrão.
#
# Você normalmente NÃO precisa criar nem editar um .env: as chaves da Groq
# e da SearchApi.io são configuradas direto pelo app ENVIO CRED (Config >
# Chaves de IA), e o token da API é gerado sozinho na primeira vez que o
# servidor liga (aparece no terminal, é só copiar pro app).
#
# Use este arquivo só se quiser mudar algum padrão manualmente. Se usar,
# copie para ".env" -- esse nunca entra no Git (ver .gitignore).

# --- Groq (IA de atendimento) ---
# Modelo recomendado: suporta função/ferramenta e tem bom português.
# Ver server/README.md para a justificativa da escolha.
GROQ_MODEL=openai/gpt-oss-120b

# --- SearchApi.io (IA de pesquisa, só usada quando o Groq não souber responder) ---
RESEARCH_PROVIDER=searchapi

# --- WhatsApp (Baileys -- aparelho conectado, pareamento por código) ---
# Pasta onde a sessão do WhatsApp fica salva em disco. Não precisa existir
# antes -- o servidor cria sozinho.
WHATSAPP_SESSION_DIR=./dados/sessao-whatsapp
# Número que vai ser pareado (com DDI+DDD, só números). Já vem com o padrão certo.
WHATSAPP_PHONE_NUMBER=5583999628152

# --- Banco de dados ---
DATABASE_PATH=./dados/enviocred.sqlite

# --- Servidor HTTP ---
PORT=3000
HOST=0.0.0.0

# --- Horário de atendimento automático (24h, fuso do aparelho) ---
HORARIO_INICIO=08:00
HORARIO_FIM=20:00
